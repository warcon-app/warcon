{
	"name": "warcon",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"description": "Self-hostable multi-server RCON panel for WARDOGS dedicated servers. Bun + SvelteKit + Postgres/TimescaleDB, Docker Compose.",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun ./build/index.js",
		"preview": "bun run build && bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/barlow": "^5.3.0",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"better-auth": "1.7.2",
		"drizzle-orm": "^0.45.2"
	},
	"engines": {
		"bun": ">=1.2"
	}
}
