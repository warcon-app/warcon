# Copy to .env. `bun run dev` reads it automatically; in Docker pass it with `env_file`.

# Required. Signs sessions: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Required. Base64 of 32 random bytes; encrypts stored RCON passwords: `openssl rand -base64 32`
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Required: the exact URL people open (scheme, host, port). Form posts from any other origin are
# rejected, and cookies are marked Secure only when it starts with https://. `bun run dev` serves
# http://localhost:5173; Docker serves http://<host>:3000 or whatever your proxy fronts it with.
ORIGIN=http://localhost:3000
# Behind a proxy (Caddy, nginx, Traefik, Cloudflare Tunnel): the header it puts the client IP in.
# x-forwarded-for (XFF_DEPTH=1 reads the address your proxy appended), x-real-ip, or cf-connecting-ip.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Postgres connection. Docker Compose sets DATABASE_URL itself from POSTGRES_PASSWORD; set it here for `bun run dev`.
# DATABASE_URL=postgres://warcon:warcon@127.0.0.1:5432/warcon
POSTGRES_PASSWORD=change-me
# HTTP port (adapter-node). PORT=3000

# Optional
# SETUP_TOKEN=choose-a-one-time-setup-secret   # required by first-run owner setup when set
# STEAM_API_KEY=32hexchars                       # Steam persona/avatar lookup
# DISCORD_CLIENT_ID=                             # with DISCORD_CLIENT_SECRET: "Sign in with Discord" (invite links create accounts through it)
# DISCORD_CLIENT_SECRET=
# APP_NAME=Warcon
# AUDIT_LOG_READS=false        # also audit read-only game calls (noisy)
# ALLOW_ORG_SIGNUP=false       # anyone may create an account and their own organisation at /sign-up
# TURNSTILE_SITE_KEY=          # with TURNSTILE_SECRET_KEY: Cloudflare Turnstile on the password sign-up forms
# TURNSTILE_SECRET_KEY=
# ALLOW_DEMO_SERVER=true       # host "demo" + password "demo" hits the built-in mock game server
# GAME_TLS_INSECURE=false      # accept self-signed certificates on https game servers
# POLL_SECONDS=20              # analytics sampling interval per server (0 disables)
